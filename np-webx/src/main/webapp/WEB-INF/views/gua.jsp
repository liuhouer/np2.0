            koujue: "天赐穷人一封金，不争不夺两平分。彼此分得金到手，不仅得利更得人。\n二人分金气祥和，谋望求财吉庆多。口舌渐消疾病少，走失行人回旧窝。"
        },
        "000100": {
            id: 16,
            name: "豫",
            symbol: "䷏",
            upper: "坤", lower: "震",
            guaci: "利建侯，行师。",
            yaoci: [
                "鸣豫，凶。",
                "介于石，不终日，贞吉。",
                "盱豫，悔。迟有悔。",
                "由豫，大有得；勿疑。朋盍簪。",
                "贞疾，恒不死。",
