<%@ page language="java" contentType="text/html; charset=UTF-8"
         pageEncoding="UTF-8" %>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <title>铜钱摇卦 — 六爻起卦</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        :root {
            --bg-dark: #0f0c07;
            --paper: #f8f1e9;
            --copper: #b87333;
            --copper-dark: #8b5a2b;
            --gold: #d4af37;
            --text-main: #2c1e0f;
            --text-light: #4a3728;
        }

        * {
            margin:0;
            padding:0;
            box-sizing:border-box;
        }

        html, body {
            height:100%;
            font-family: "KaiTi", "SimSun", "Songti SC", serif;
            background: var(--bg-dark);
            color: var(--text-main);
            overflow-x: hidden;
        }

        .container {
            min-height:100vh;
            padding: 2vh 4vw;
            background: radial-gradient(circle at 50% 20%, #1a140e 0%, #0f0c07 70%);
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        h1 {
            font-size: clamp(2.8rem, 8vw, 5.5rem);
            color: var(--gold);
            text-shadow: 0 0 20px rgba(212,175,55,0.4);
            margin: 4vh 0 1vh;
            letter-spacing: 0.15em;
            font-weight: normal;
        }

        .subtitle {
            font-size: clamp(1.1rem, 3.5vw, 1.6rem);
            color: #a68a64;
            margin-bottom: 6vh;
            opacity: 0.9;
        }

        .stage {
            width:  min(92vw, 680px);
            min-height: 520px;
            background: linear-gradient(135deg, #1e1810 0%, #140f08 100%);
            border: 1px solid #3a2a1a;
            border-radius: 18px;
            box-shadow:
                    inset 0 0 80px rgba(0,0,0,0.9),
                    0 0 60px rgba(30,20,10,0.6);
            position: relative;
            overflow: hidden;
            margin-bottom: 5vh;
            padding: 3vh 4vw;
        }

        .coins-area {
            height: 380px;
            position: relative;
            perspective: 1200px;
        }


        .coin {
            width: 120px;                /* 稍大一点更有分量 */
            height: 120px;
            background-size: cover;      /* 关键：图片铺满 */
            background-position: center;
            border-radius: 50%;
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
            box-shadow:
                    0 10px 30px rgba(0,0,0,0.8),
                    inset 0 8px 15px rgba(255,240,200,0.3),
                    inset 0 -8px 15px rgba(50,30,10,0.8);
            border: 4px solid #d4af37;   /* 金边更古朴 */
            overflow: hidden;            /* 防止图片溢出 */
            transition: transform 0.15s;
        }

        /* 正面：乾隆通宝（用一张清晰的正面图） */
        .coin.front {
            background-image: url('https://minioapi.northpark.cn/pic/coinF.jpg');
        }

        /* 反面：背面满文（常见宝泉局，用反面图） */
        .coin.back {
            background-image: url('https://minioapi.northpark.cn/pic/coinB.jpg');
        }

        /* 抛起时的 3D 效果增强（可选加旋转） */
        .coin.throwing {
            animation: throwCoin 1.2s ease-out;
        }

        @keyframes throwCoin {
            0%   { transform: translate(-50%, -50%) rotateX(0) rotateY(0) scale(1); }
            50%  { transform: translate(-50%, -300px) rotateX(720deg) rotateY(540deg) scale(1.1); }
            100% { transform: translate(-50%, -50%) rotateX(0) rotateY(0) scale(1); }
        }

        .guaci-display {
            margin: 3vh 0 1vh;
            font-size: clamp(1.4rem, 4.5vw, 2.2rem);
            color: var(--gold);
            text-align: center;
            min-height: 1.6em;
            text-shadow: 0 0 15px rgba(212,175,55,0.5);
        }

        .yaos {
            display: flex;
            flex-direction: column-reverse;
            gap: 12px;
            width: 240px;
            margin: 0 auto 4vh;
        }

        .yao {
            height: 18px;
            background: #2c1e0f;
            border: 1px solid #5a4630;
            border-radius: 6px;
            position: relative;
            overflow: hidden;
        }

        .yao.yang::before,
        .yao.yin::before {
            content:"";
            position: absolute;
            inset: 0;
        }

        .yao.yang::before {
            background: linear-gradient(90deg, transparent 10%, #d4af37 50%, transparent 90%);
            box-shadow: 0 0 20px #d4af37;
        }

        .yao.yin::before {
            background: linear-gradient(90deg, transparent 40%, #8b5a2b 50%, transparent 60%);
            opacity: 0.7;
        }

        .yao.old {
            animation: old-yao-pulse 2s infinite;
        }

        @keyframes old-yao-pulse {
            0%,100% { box-shadow: 0 0 10px #d4af37; }
            50%     { box-shadow: 0 0 30px #ffaa00, inset 0 0 20px #ff8800; }
        }

        .btn {
            padding: 14px 42px;
            font-size: 1.4rem;
            background: linear-gradient(145deg, #d4af37, #b8972e);
            color: #111;
            border: none;
            border-radius: 50px;
            cursor: pointer;
            margin: 12px;
            box-shadow: 0 8px 25px rgba(180,140,40,0.5);
            transition: all 0.25s;
            font-family: inherit;
        }

        .btn:hover {
            transform: translateY(-3px) scale(1.04);
            box-shadow: 0 15px 40px rgba(212,175,55,0.6);
        }

        .btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        .result-area {
            width: min(92vw, 720px);
            background: rgba(20,15,8,0.7);
            border: 1px solid #5a4630;
            border-radius: 16px;
            padding: 2.5vh 4vw;
            margin-top: 2vh;
            line-height: 1.8;
            font-size: 1.15rem;
            color: #e8d9c0;
        }

        .卦名 {
            color: #ffdd88;
            font-size: 1.7rem;
            margin: 0.8em 0 0.4em;
        }

        .动爻 {
            color: #ffaa44;
            font-weight: bold;
        }
    </style>
</head>
<body>

<div class="container">

    <h1>铜钱摇卦</h1>
    <div class="subtitle">心诚则灵　至诚前知</div>

    <div class="stage">
        <div class="coins-area" id="coinsArea">
            <div class="coin front" id="coin1"></div>
            <div class="coin front" id="coin2"></div>
            <div class="coin front" id="coin3"></div>
        </div>

        <div class="guaci-display" id="status">请摇卦（共需摇六次）</div>

        <div class="yaos" id="yaos"></div>

        <div style="text-align:center; margin-top:20px;">
            <button class="btn" id="shakeBtn">摇一卦</button>
            <button class="btn" id="resetBtn" disabled>重新起卦</button>
        </div>
    </div>

    <div class="result-area" id="result" style="display:none;"></div>

</div>

<script>
    // ──────────────────────────────────────────────
    const YAOS_NAME = ["初","二","三","四","五","上"];
    const YAO_SYMBOL = {
        6:  "⚋×",   // 老阴
        7:  "—",     // 少阳
        8:  "⚋",     // 少阴
        9:  "—○"     // 老阳
    };

    let yaos = [];           // 存放 6 个爻的值 6/7/8/9
    let currentThrow = 0;

    // 必须在这里定义 coin 元素（页面加载后获取）
    let coin1, coin2, coin3;

    // 简易64卦数据（仅示例，实际项目应完整录入）
    // gua64.js - 完整的64卦数据（基于提供的 iching.json）
    // 二进制键：从下往上，初爻为最低位，阳=1 阴=0

    const gua64 = {
        "111111": {
            id: 1,
            name: "乾",
            symbol: "䷀",
            upper: "乾", lower: "乾",
            guaci: "元亨利贞。",
            yaoci: [
                "潜龙，勿用。",
                "见龙在田，利见大人。",
                "君子终日乾乾，夕惕若，厉无咎。",
                "或跃在渊，无咎。",
                "飞龙在天，利见大人。",
                "亢龙有悔。"
            ],
            koujue: "困龙得水好运交，不由喜气上眉梢。一切谋望皆如意，往后时运渐渐高。\n蟠龙久困在渊中，一日升腾起半空。往来飞腾能变化，从今有祸不成凶。"
        },
        "000000": {
            id: 2,
            name: "坤",
            symbol: "䷁",
            upper: "坤", lower: "坤",
            guaci: "元亨，利牝马之贞。君子有攸往，先迷，后得主，利。西南得朋，东北丧朋。安贞吉。",
            yaoci: [
                "履霜，坚冰至。",
                "直方大，不习无不利。",
                "含章可贞；或从王事，无成有终。",
                "括囊，无咎无誉。",
                "黄裳，元吉。",
                "龙战于野，其血玄黄。"
            ],
            koujue: "肥羊失群入山冈，饿虎碰到把口张。适口充饥心欢喜，君占此卦大吉昌。\n饿虎得食喜气欢，求名应试得高迁。出门吉利行人到，是非口舌不沾边。"
        },
        "100010": {
            id: 3,
            name: "屯",
            symbol: "䷂",
            upper: "震", lower: "坎",
            guaci: "元亨，利贞；勿用有攸往，利建侯。",
            yaoci: [
                "磐桓；利居贞，利建侯。",
                "屯如，邅如，乘马班如。匪寇婚媾。女子贞不字，十年乃字。",
                "即鹿无虞，惟入于林中，君子几，不如舍，往吝。",
                "乘马班如，求婚媾，往吉，无不利。",
                "屯其膏，小贞吉，大贞凶。",
                "乘马班如，泣血涟如。"
            ],
            koujue: "风刮乱丝不见头，颠三倒四犯忧愁。慢慢处理尚可顺，急促反惹不自由。\n乱丝无头实难择，遇事暂且往后推。交易出行无好处，谋望求财心不遂。"
        },
        "010001": {
            id: 4,
            name: "蒙",
            symbol: "䷃",
            upper: "坎", lower: "艮",
            guaci: "亨。匪我求童蒙，童蒙求我。初筮告，再三渎，渎则不告。利贞。",
            yaoci: [
                "发蒙，利用刑人，用说桎梏；以往吝。",
                "包蒙，吉。纳妇，吉；子克家。",
                "勿用取女，见金夫，不有躬，无攸利。",
                "困蒙，吝。",
                "童蒙，吉。",
                "击蒙；不利为寇，利御寇。"
            ],
            koujue: "卦中爻象犯小耗，君子占之运不高。婚姻合伙有琐碎，做事必然受苦劳。\n卦中气象犯小耗，谋望求财空过桥。婚姻合伙有人破，交易出行枉徒劳。"
        },
        "111010": {
            id: 5,
            name: "需",
            symbol: "䷄",
            upper: "乾", lower: "坎",
            guaci: "有孚，光亨，贞吉，利涉大川。",
            yaoci: [
                "需于郊，利用恒，无咎。",
                "需于沙，小有言；终吉。",
                "需于泥，致寇至。",
                "需于血，出自穴。",
                "需于酒食，贞吉。",
                "入于穴，有不速之客三人来；敬之，终吉。"
            ],
            koujue: "明珠土埋日久深，无光无亮到如今。忽然大风吹土去，自然显露又重新。\n明珠出土离尘埃，口舌官司消散开。走失行人当见面，交易有成永无灾。"
        },
        "010111": {
            id: 6,
            name: "讼",
            symbol: "䷅",
            upper: "坎", lower: "乾",
            guaci: "有孚，窒惕，中吉。终凶。利见大人，不利涉大川。",
            yaoci: [
                "不永所事，小有言，终吉。",
                "不克讼，归而逋，其邑人三百户，无眚。",
                "食旧德，贞厉，终吉；或从王事，无成。",
                "不克讼；复即命，渝，安贞，吉。",
                "讼，元吉。",
                "或锡之鞶带，终朝三褫之。"
            ],
            koujue: "心中有事实难顾，恰似二人争走路。两下都是要争先，谁肯让谁走一步？\n二人争路不肯让，占卦逢之费主张。交易出行有阻碍，生意合伙也平常。"
        },
        "010000": {
            id: 7,
            name: "师",
            symbol: "䷆",
            upper: "坎", lower: "坤",
            guaci: "贞，丈人吉，无咎。",
            yaoci: [
                "师出以律，否臧凶。",
                "在师中吉，无咎；王三锡命。",
                "师或舆尸，凶。",
                "师左次，无咎。",
                "田有禽，利执言，无咎；长子帅师，弟子舆尸，贞凶。",
                "大君有命，开国承家，小人勿用。"
            ],
            koujue: "将帅领兵去出征，骑着烈马拉硬弓。百步穿杨射得准，旗开得胜喜气生。\n马到成功喜气扬，求名取利大吉昌。婚姻合伙无妨碍，交易出行也顺当。"
        },
        "000010": {
            id: 8,
            name: "比",
            symbol: "䷇",
            upper: "坤", lower: "坎",
            guaci: "吉。原筮，元永贞，无咎。不宁方来，后夫凶。",
            yaoci: [
                "有孚比之，无咎；有孚盈缶，终来有它，吉。",
                "比之自内，贞吉。",
                "比之匪人。",
                "外比之，贞吉。",
                "显比；王用三驱，失前禽。邑人不诫，吉。",
                "比之无首，凶。"
            ],
            koujue: "顺风行船扯起蓬，上天又助一阵风。不用费力逍遥去，任意而行大亨通。\n船得顺风任飘蓬，投向有准宜出行。交易求财大得利，一切谋望事有成。"
        },
        "111011": {
            id: 9,
            name: "小畜",
            symbol: "䷈",
            upper: "乾", lower: "巽",
            guaci: "亨。密云不雨，自我西郊。",
            yaoci: [
                "复自道，何其咎？吉。",
                "牵复，吉。",
                "舆说辐，夫妻反目。",
                "有孚，血去惕出，无咎。",
                "有孚挛如，富以其邻。",
                "既雨既处，尚德载；妇贞厉，月几望；君子征凶。"
            ],
            koujue: "苗逢旱天尽焦稍，谁想云浓雨不浇。农人仰面长叹气，事从缓来莫心高。\n浓云密排下雨难，盼望行人不见还。交易出行空费力，婚姻求财也枉然。"
        },
        "110111": {
            id: 10,
            name: "履",
            symbol: "䷉",
            upper: "兑", lower: "乾",
            guaci: "履虎尾，不咥人，亨。",
            yaoci: [
                "素履，往，无咎。",
                "履道坦坦，幽人贞吉。",
                "眇能视，跛能履，履虎尾，咥人，凶；武人为于大君。",
                "履虎尾，愬愬，终吉。",
                "夬履，贞厉。",
                "视履考祥，其旋元吉。"
            ],
            koujue: "凤凰落在西歧山，长鸣一声出圣贤。天降文王开基业，富贵荣华八百年。\n凤鸣岐山闻四方，占者逢之大吉昌。走失行人有音信，生意兴隆人财旺。"
        },
        "111000": {
            id: 11,
            name: "泰",
            symbol: "䷊",
            upper: "乾", lower: "坤",
            guaci: "小往大来，吉，亨。",
            yaoci: [
                "拔茅茹，以其汇，征吉。",
                "包荒，用冯河，不遐遗；朋亡，得尚于中行。",
                "无平不陂，无往不复；艰贞无咎，勿恤其孚，于食有福。",
                "翩翩，不富，以其邻，不戒以孚。",
                "帝乙归妹，以祉元吉。",
                "城复于隍，勿用师，自邑告命，贞吝。"
            ],
            koujue: "学问满腹入场闱，三元及第得意回。从今解去愁和闷，且喜平地一声雷。\n喜报三元运气强，谋望求财大吉祥。交易出行多得意，是非口舌皆无妨。"
        },
        "000111": {
            id: 12,
            name: "否",
            symbol: "䷋",
            upper: "坤", lower: "乾",
            guaci: "否之匪人，不利君子贞，大往小来。",
            yaoci: [
