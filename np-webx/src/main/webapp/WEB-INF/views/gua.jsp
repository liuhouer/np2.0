        },
        "111101": {
            id: 14,
            name: "大有",
            symbol: "䷍",
            upper: "乾", lower: "离",
            guaci: "元亨。",
            yaoci: [
                "无交害，匪咎；艰则无咎。",
                "大车以载，有攸往，无咎。",
                "公用亨于天子，小人弗克。",
