        "110001": {
            id: 41,
            name: "损",
            symbol: "䷨",
            upper: "兑", lower: "艮",
            guaci: "有孚，元吉，无咎，可贞，利有攸往。曷之用？二簋可用享。",
            yaoci: [
                "已事遄往，无咎；酌损之。",
                "利贞，征凶；弗损益之。",
                "三人行，则损一人；一人行，则得其友。",
                "损其疾，使遄有喜，无咎。",
                "或益之十朋之龟，弗克违，元吉。",
                "弗损益之，无咎。贞吉，利有攸往，得臣无家。"
            ],
            koujue: "时运不至费心多，好比推车受折磨。上山路上掉车耳，左安右安安不着。\n推车掉耳路难行，心有打算力不能。君子占此琐碎卦，纵无灾害也困穷。"
        },
        "100011": {
            id: 42,
            name: "益",
            symbol: "䷩",
            upper: "震", lower: "巽",
            guaci: "利有攸往，利涉大川。",
            yaoci: [
                "利用为大作，元吉，无咎。",
                "或益之十朋之龟，弗克违。永贞吉；王用享于帝，吉。",
                "益之用凶事，无咎；有孚中行，告公用圭。",
                "中行，告公从，利用为依迁国。",
                "有孚惠心，勿问元吉。有孚惠我德。",
                "莫益之，或击之，立心勿恒，凶。"
            ],
            koujue: "时来运转生气发，多年枯木又开花。枝叶重生多繁茂，几人见了几人夸。\n枯木开花渐渐荣，主君事业大兴隆。婚姻求财多吉庆，口舌疾病俱安宁。"
        },
        "111110": {
            id: 43,
            name: "夬",
            symbol: "䷪",
            upper: "乾", lower: "兑",
            guaci: "扬于王庭，孚号有厉；告自邑，不利即戎，利有攸往。",
            yaoci: [
                "壮于前趾，往不胜为咎。",
                "惕号，莫夜有戎，勿恤。",
                "壮于頄，有凶。君子夬夬独行，遇雨若濡，有愠无咎。",
                "臀无肤，其行次且；牵羊悔亡，闻言不信。",
                "苋陆夬夬，中行无咎。",
                "无号，终有凶。"
            ],
            koujue: "蜘蛛结网赛天牢，粘住游蜂翅翎毛。幸亏大风吹破网，脱离灾难又逍遥。\n游蜂脱网喜无边，添财进口福禄连。外则通达内则顺，富贵荣华胜先前。"
        },
        "011111": {
            id: 44,
            name: "姤",
            symbol: "䷫",
            upper: "巽", lower: "乾",
            guaci: "女壮，勿用取女。",
            yaoci: [
                "系于金柅，贞吉；有攸往，见凶，羸豕孚踯躅。",
                "包有鱼，无咎，不利宾。",
                "臀无肤，其行次且；厉，无大咎。",
                "包无鱼，起凶。",
                "以杞包瓜，含章，有陨自天。",
                "姤其角，吝，无咎。"
            ],
            koujue: "他乡遇友喜气欢，须知运气福重添。自今交了顺当运，向后保管不相干。"
        },
        "000110": {
            id: 45,
            name: "萃",
            symbol: "䷬",
            upper: "坤", lower: "兑",
            guaci: "亨，王假有庙，利见大人，亨，利贞；用大牲吉，利有攸往。",
            yaoci: [
                "有孚不终，乃乱乃萃；若号，一握为笑，勿恤，往无咎。",
                "引吉，无咎；孚乃利用禴。",
                "萃如，嗟如，无攸利；往无咎，小吝。",
                "大吉，无咎。",
                "萃有位，无咎；匪孚，元永贞，悔亡。",
                "赍咨涕洟，无咎。"
            ],
            koujue: "游鱼戏水受网惊，跳过龙门身化龙。三尺杨柳垂金线，万朵桃花显神通。\n鲤鱼化龙喜气来，口舌疾病不成灾。忧愁疑虑尽消散，祸门闭来福门开。"
        },
        "011000": {
            id: 46,
            name: "升",
            symbol: "䷭",
            upper: "巽", lower: "坤",
            guaci: "元亨，用见大人，勿恤。南征吉。",
            yaoci: [
                "允升，大吉。",
                "孚乃利用禴，无咎。",
                "升虚邑。",
                "王用亨于岐山，吉无咎。",
                "贞吉，升阶。",
                "冥升，利于不息之贞。"
            ],
            koujue: "士人来占必得名，生意买卖也兴隆。匠艺逢之交易好，农家庄稼亦收成。\n指日高升气象新，走失行人有音信。功名出行遂心愿，疾病口舌皆除根。"
        },
        "010110": {
            id: 47,
            name: "困",
            symbol: "䷮",
            upper: "坎", lower: "兑",
            guaci: "亨。贞，大人吉，无咎；有言不信。",
            yaoci: [
                "臀困于株木，入于幽谷，三岁不觌。",
                "困于酒食，朱绂方来，利用享祀；征凶，无咎。",
                "困于石，据于蒺藜，入于其宫，不见其妻，凶。",
                "来徐徐，困于金车，吝，有终。",
                "劓刖，困于赤绂，乃徐有说，利用祭祀。",
                "困于葛藟，于臲卼，曰动悔，有悔。征吉。"
            ],
            koujue: "时运不好小人欺，千方百计来商议。好话哄你上了当，撮上楼去抽了梯。\n撮楼抽梯是霉运，劝君交往要谨慎。遇事但从稳中来，亲近君子远小人。"
        },
        "011010": {
            id: 48,
            name: "井",
            symbol: "䷯",
            upper: "巽", lower: "坎",
            guaci: "改邑不改井，无丧无得，往来井井；汔至，亦未繘井，羸其瓶，凶。",
            yaoci: [
                "井泥不食，旧井无禽。",
                "井谷射鲋，瓮敝漏。",
                "井渫不食，为我心恻；可用汲，王明，并受其福。",
                "井甃，无咎。",
                "井冽，寒泉食。",
                "井收勿幕，有孚元吉。"
            ],
            koujue: "枯井荒废已多年，一朝忽然流清泉。救生解渴人称羡，时来运转喜自然。\n枯井生泉福禄加，吉祥如意放光华。以前虽有背运日，往后自然能发达。"
        },
        "101110": {
            id: 49,
            name: "革",
            symbol: "䷰",
            upper: "离", lower: "兑",
            guaci: "巳日乃孚，元亨利贞，悔亡。",
            yaoci: [
                "巩用黄牛之革。",
                "巳日乃革之，征吉，无咎。",
                "征凶，贞厉；革言三就，有孚。",
                "悔亡，有孚改命，吉。",
                "大人虎变，未占有孚。",
                "君子豹变，小人革面；征凶，居贞吉。"
            ],
            koujue: "苗逢旱天渐渐衰，幸得天恩降雨来。忧去喜来能变化，谋求干事遂心怀。\n旱苗得雨长势旺，祸去福来大吉祥。婚姻求财都如意，官司疾病皆无妨。"
        },
        "011101": {
            id: 50,
            name: "鼎",
            symbol: "䷱",
            upper: "巽", lower: "离",
            guaci: "元吉，亨。",
            yaoci: [
                "鼎颠趾，利出否；得妾以其子，无咎。",
                "鼎有实，我仇有疾，不我能即，吉。",
                "鼎耳革，其行塞。雉膏不食；方雨亏悔，终吉。",
                "鼎折足，覆公餗，其形渥，凶。",
                "鼎黄耳，金铉，利贞。",
                "鼎玉铉，大吉，无不利。"
            ],
            koujue: "莺鹭蛤蜊落沙滩，拼命挣扎两翅扇。渔翁近前双得利，卦若逢之喜气添。\n渔翁得利喜自然，求名求财两周全。婚姻合伙双得利，走失行人却自还。"
        },
        "100100": {
            id: 51,
            name: "震",
            symbol: "䷲",
            upper: "震", lower: "震",
            guaci: "亨。震来虩虩，笑言哑哑。震惊百里，不丧匕鬯。",
            yaoci: [
                "震来虩虩，后笑言哑哑，吉。",
                "震来厉，亿丧贝，跻于九陵，勿逐，七日得。",
                "震苏苏，震行无眚。",
                "震遂泥。",
                "震往来，厉；亿无丧，有事。",
                "震索索，视矍矍，征凶。震不于其躬，于其邻，无咎。婚媾有言。"
            ],
            koujue: "一口金钟在淤泥，人人拿着当顽石。忽然一日钟悬起，一声响亮天下知。\n占者逢之撞金钟，时来运转扬名声。谋望求财不费力，交易出行定有功。"
        },
        "001001": {
            id: 52,
            name: "艮",
            symbol: "䷳",
            upper: "艮", lower: "艮",
            guaci: "艮其背，不获其身；行其庭，不见其人，无咎。",
            yaoci: [
                "艮其趾，无咎，利永贞。",
                "艮其腓，不拯其随，其心不快。",
                "艮其限，列其夤，厉熏心。",
                "艮其身，无咎。",
                "艮其辅，言有序，悔亡。",
                "敦艮，吉。"
            ],
            koujue: "好事常打心头走，可惜眼前难到手。不如意时且忍耐，遇到闲事休开口。\n矬巴勾枣难捞枝，目前诸事皆不宜。谋望求财空费力，婚姻合伙总是虚。"
        },
        "001011": {
            id: 53,
            name: "渐",
            symbol: "䷴",
            upper: "艮", lower: "巽",
            guaci: "女归吉，利贞。",
            yaoci: [
                "鸿渐于干；小子厉，有言，无咎。",
                "鸿渐于磐，饮食衎衎，吉。",
                "鸿渐于陆，夫征不复，妇孕不育，凶；利御寇。",
                "鸿渐于木，或得其桷，无咎。",
                "鸿渐于陵，妇三岁不孕；终莫之胜，吉。",
                "鸿渐于陆，其羽可用为仪，吉。"
            ],
            koujue: "俊鸟幸得出牢笼，脱离灾难显威风。一朝得意福星至，东南西北任我行。\n俊鸟出笼万里翔，交易出行大吉昌。寻人费力逃难好，官司疾病都无妨。"
        },
        "110100": {
            id: 54,
            name: "归妹",
            symbol: "䷵",
            upper: "兑", lower: "震",
            guaci: "征凶，无攸利。",
            yaoci: [
                "归妹以娣，跛能履，征吉。",
                "眇能视，利幽人之贞。",
                "归妹以须，反归以娣。",
                "归妹愆期，迟归有时。",
                "帝乙归妹，其君之袂，不如其娣之袂良；月几望，吉。",
                "女承筐，无实；士刲羊，无血。无攸利。"
            ],
            koujue: "摸鱼应该到水中，树上摸鱼不顺情。受尽巴结难遂意，劳而无功运平平。\n缘木求鱼胡来来，不能得鱼有后灾。若是行险耍乖巧，枉费心机空安排。"
        },
        "101100": {
            id: 55,
            name: "丰",
            symbol: "䷶",
            upper: "离", lower: "震",
            guaci: "亨，王假之；勿忧，宜日中。",
            yaoci: [
                "遇其配主，虽旬无咎，往有尚。",
                "丰其蔀，日中见斗。往得疑疾，有孚发若，吉。",
                "丰其沛，日中见沬；折其右肱，无咎。",
                "丰其蔀，日中见斗，遇其夷主，吉。",
                "来章，有庆誉，吉。",
                "丰其屋，蔀其家，窥其户，阒其无人，三岁不觌，凶。"
            ],
            koujue: "古镜昏暗这些年，一朝重磨比月圆。君子谋事逢此卦，时来运转喜自然。\n古镜重明光辉显，主人目下运气转。婚姻求财多吉庆，走失行人去不远。"
        },
        "001101": {
            id: 56,
            name: "旅",
            symbol: "䷷",
            upper: "艮", lower: "离",
            guaci: "小亨，旅贞吉。",
            yaoci: [
                "旅琐琐，斯其所取灾。",
                "旅即次，怀其资，得童仆，贞。",
                "旅焚其次，丧其童仆，贞厉。",
                "旅于处，得其资斧，我心不快。",
                "射雉，一矢亡；终以誉命。",
                "鸟焚其巢，旅人先笑后号啕；丧牛于易，凶。"
            ],
            koujue: "飞鸟树上筑窝巢，小人用计举火烧。君占此卦为不吉，一切谋求枉徒劳。\n宿鸟焚巢时运低，婚姻不成病难医。交易合伙皆不利，官事口舌被人欺。"
        },
        "011011": {
            id: 57,
            name: "巽",
            symbol: "䷸",
            upper: "巽", lower: "巽",
            guaci: "小亨，利有攸往，利见大人。",
            yaoci: [
                "进退，利武人之贞。",
                "巽在床下，用史巫纷若，吉，无咎。",
                "频巽，吝。",
                "悔亡，田获三品。",
                "贞吉，悔亡，无不利。无初有终。先庚三日，后庚三日，吉。",
                "巽在床下，丧其资斧，贞凶。"
            ],
            koujue: "俊鸟出笼万里翔，交易出行大吉昌。寻人费力逃难好，官司疾病都无妨。"
        },
        "110110": {
            id: 58,
            name: "兑",
            symbol: "䷹",
            upper: "兑", lower: "兑",
            guaci: "亨，利贞。",
            yaoci: [
                "和兑，吉。",
                "孚兑，吉，悔亡。",
                "来兑，凶。",
                "商兑未宁，介疾有喜。",
                "孚于剥，有厉。",
                "引兑。"
            ],
            koujue: "这个卦象真有趣，觉着做事不费力。休要错过这时机，事事称心又如意。\n趁水和泥泥更匀，投向有准宜出门。交易婚姻皆有成，走失行人不用寻。"
        },
        "010011": {
            id: 59,
            name: "涣",
            symbol: "䷺",
            upper: "坎", lower: "巽",
            guaci: "亨，王假有庙，利涉大川，利贞。",
            yaoci: [
                "用拯马壮，吉。",
                "涣奔其机，悔亡。",
                "涣其躬，无悔。",
                "涣其群，元吉；涣有丘，匪夷所思。",
                "涣汗其大号，涣王居，无咎。",
                "涣其血去逖出，无咎。"
            ],
            koujue: "隔河望见一锭金，欲取河宽水又深。指望发财难到手，昼夜思想枉费心。\n财帛隔着一道河，河宽水深摸不着。过后交节方吉利，目下不宜瞎琢磨。"
        },
        "110010": {
            id: 60,
            name: "节",
            symbol: "䷻",
            upper: "兑", lower: "坎",
            guaci: "亨，苦节，不可贞。",
            yaoci: [
                "不出户庭，无咎。",
                "不出门庭，凶。",
                "不节若，则嗟若，无咎。",
                "安节，亨。",
                "甘节，吉。往有尚。",
                "苦节，贞凶，悔亡。"
            ],
            koujue: "时来运转喜气生，登台封神姜太公。到此诸神皆退位，纵然有祸不成凶。\n太公封神事非凡，谋望求财稳如山。交易合伙大吉庆，疾病口舌消除完。"
        },
        "110011": {
            id: 61,
            name: "中孚",
            symbol: "䷼",
            upper: "兑", lower: "巽",
            guaci: "豚鱼吉，利涉大川，利贞。",
            yaoci: [
                "虞吉，有他不燕。",
                "鸣鹤在阴，其子和之；我有好爵，吾与尔靡之。",
                "得敌，或鼓或罢，或泣或歌。",
                "月几望，马匹亡，无咎。",
                "有孚挛如，无咎。",
                "翰音登于天，贞凶。"
            ],
            koujue: "路上行人急匆匆，无路无桥走薄冰。小心谨慎过得去，一步错了落水中。\n行人走冰怕冰薄，交易出行犯琢磨。婚姻合伙休大意，官司口舌须要和。"
        },
        "001100": {
            id: 62,
            name: "小过",
            symbol: "䷽",
            upper: "艮", lower: "震",
            guaci: "亨，利贞；可小事，不可大事；飞鸟遗之音，不宜上，宜下，大吉。",
            yaoci: [
                "飞鸟以凶。",
                "过其祖，遇其妣；不及其君，遇其臣，无咎。",
                "弗过防之，从或戕之，凶。",
                "无咎，弗过遇之；往厉必戒，勿用永贞。",
                "密云不雨，自我西郊；公弋取彼在穴。",
                "弗遇过之；飞鸟离之，凶，是谓灾眚。"
            ],
            koujue: "行人路过独木桥，心内惶恐眼里瞧。爽利保你过得去，犹豫恐怕不安牢。\n独木桥上步难行，主人心事不安宁。交易合伙宜趁早，婚姻有成切末停。"
        },
        "101010": {
            id: 63,
            name: "既济",
            symbol: "䷾",
            upper: "离", lower: "坎",
            guaci: "亨小，利贞。初吉终乱。",
            yaoci: [
                "曳其轮，濡其尾，无咎。",
                "妇丧其茀，勿逐，七日得。",
                "高宗伐鬼方，三年克之；小人勿用。",
                "繻有衣袽，终日戒。",
                "东邻杀牛，不如西邻之禴祭，实受其福。",
                "濡其首，厉。"
            ],
            koujue: "金榜之上题姓名，不负当年苦用功。人逢此卦多吉庆，一切谋望大亨通。\n金榜题名喜气新，十人遇着九遂心。从今交了顺当运，步步登高事事顺。"
        },
        "010101": {
            id: 64,
            name: "未济",
            symbol: "䷿",
            upper: "坎", lower: "离",
            guaci: "亨，小狐汔济，濡其尾，无攸利。",
            yaoci: [
                "濡其尾，吝。",
                "曳其轮，贞吉。",
                "未济，征凶，利涉大川。",
                "贞吉，悔亡；震用伐鬼方，三年有赏于大国。",
                "贞吉，无悔；君子之光，有孚，吉。",
                "有孚于饮酒；无咎，濡其首，有孚失是。"
            ],
            koujue: "开沟掘地几丈深，提防偷营劫寨人。时逢太岁为凶煞，小心谨慎祸不侵。\n太岁入运事多愁，婚姻财帛莫强求。交易出行不见吉，走失行人不露头。"
        }
    }

    function randomCoin() {
        // 传统三枚铜钱：每枚50%正反 → 数字和为 6,7,8,9
        return Math.random() < 0.5 ? 2 : 3;   // 2=背(阴)，3=字(阳)
    }

    // 全局新增一个标志：是否正在摇卦（防止连点）
    let isThrowing = false;   // 默认false，表示空闲

    function throwCoins() {
        console.log("throwCoins 被调用，当前状态：", { currentThrow, isThrowing });

        if (isThrowing) {
            console.log("正在动画中，忽略本次点击");
            return;
        }
        if (currentThrow >= 6) {
            console.log("已满6爻，忽略点击");
            return;
        }

        // 每次摇前重新获取元素（防止 JSP 渲染时机问题）
        coin1 = document.getElementById("coin1");
        coin2 = document.getElementById("coin2");
        coin3 = document.getElementById("coin3");

        if (!coin1 || !coin2 || !coin3) {
            console.error("铜钱元素未找到！ID 检查：coin1/coin2/coin3");
            alert("页面元素加载失败，请刷新重试");
            return;
        }

        isThrowing = true;
        document.getElementById("shakeBtn").disabled = true;

        const coins = [coin1, coin2, coin3];
        const results = [randomCoin(), randomCoin(), randomCoin()];
        const sum = results.reduce((a, b) => a + b, 0);

        console.log(`第 ${currentThrow + 1} 次摇卦 → 和值: ${sum} (爻值即将push)`);

        // 动画
        coins.forEach((el, i) => {
            el.className = "coin";
            el.style.transition = "none";
            el.style.transform = `translate(-50%, -50%) translateY(-300px) rotateX(${Math.random()*800-400}deg) rotateY(${Math.random()*800-400}deg)`;

            setTimeout(() => {
                el.style.transition = "transform 1.2s cubic-bezier(0.16, 0.8, 0.3, 1)";
                el.className = "coin " + (results[i] === 2 ? "back" : "front") + " throwing";
                el.style.transform = `translate(-50%, -50%) rotateX(0) rotateY(0)`;
            }, 80 + i * 120);
        });

        // 动画结束回调
        setTimeout(() => {
            yaos.push(sum);
            currentThrow++;
            console.log(`爻已累加，现在第 ${currentThrow} 爻，总爻数组:`, yaos);

            renderYaos();

            const statusEl = document.getElementById("status");
            if (currentThrow >= 6) {
                console.log("满6爻，调用 showResult()");
                showResult();
                document.getElementById("shakeBtn").disabled = true;
                if (statusEl) statusEl.textContent = "六爻已成，结果已出";
            } else {
                if (statusEl) {
                    statusEl.textContent = `第 ${currentThrow + 1} 爻　（共六爻）`;
                    console.log("状态已更新为：", statusEl.textContent);
                } else {
                    console.error("status 元素丢失");
                }
                isThrowing = false;
                document.getElementById("shakeBtn").disabled = false;
            }
        }, 1400);
    }

    // 渲染爻
    function renderYaos() {
        const container = document.getElementById("yaos");
        if (!container) {
            console.error("yaos 容器未找到");
            return;
        }
        container.innerHTML = "";
        for (let i = 0; i < yaos.length; i++) {
            const val = yaos[i];
            const div = document.createElement("div");
            div.className = "yao " + ((val === 6 || val === 9) ? "old" : "") + " " + (val % 2 ? "yang" : "yin");
            container.appendChild(div);
        }
    }

    function getBinaryFromYaos() {
        // 从下到上，阳=1 阴=0
        let bin = "";
        for(let v of yaos){
            bin = (v%2===1 ? "1":"0") + bin;  // 注意顺序：初爻在最低位
        }
        return bin;
    }

    function getChangedBinary() {
        let bin = "";
        for(let v of yaos){
            let bit;
            if(v === 9) bit = "0";      // 老阳 → 阴
            else if(v === 6) bit = "1"; // 老阴 → 阳
            else bit = v%2===1 ? "1":"0";
            bin = bit + bin;
        }
        return bin;
    }

    function showResult() {
        // 强制锁定按钮，防止任何边缘情况
        document.getElementById("shakeBtn").disabled = true;
        document.getElementById("status").textContent = "六爻已成，结果已出";

        const ben = getBinaryFromYaos();   // "100010" 这样的字符串
        const zhi = getChangedBinary();
        const hasChange = ben !== zhi;

        const benGua = gua64[ben] || {name:"未知", guaci:"——", yaoci:[]};
        const zhiGua = gua64[zhi] || {name:"未知", guaci:"——"};

        let html = `<h2 style="color:#ffdd88;">本卦：${benGua.name} ${benGua.symbol}</h2>`;
        html += `<p style="font-size:1.3rem; color:#ddd;">${benGua.guaci}</p>`;

        if (hasChange) {
            html += `<div style="font-size:2.5rem; margin:1.2em 0; color:#ffaa44;">↓ 变 ↓</div>`;
            html += `<h2 style="color:#ffdd88;">之卦：${zhiGua.name} ${zhiGua.symbol}</h2>`;
            html += `<p style="font-size:1.3rem; color:#ddd;">${zhiGua.guaci}</p>`;
        }

        // ── 新增：动爻爻辞 ────────────────────────────────
        html += `<div style="margin:2em 0; padding:1em; background:rgba(30,20,10,0.5); border-radius:12px;">`;
        html += `<strong style="color:#ffcc66; font-size:1.4rem;">动爻详解：</strong><br><br>`;

        let hasAnyDong = false;
        yaos.forEach((v, i) => {
            if (v === 6 || v === 9) {
                hasAnyDong = true;
                const yaoName = ["初","二","三","四","五","上"][i];
                const yaoCi = benGua.yaoci[i] || "（爻辞缺失）";
                const symbol = v===9 ? "—○" : "⚋×";
                const changeText = v===9 ? "（老阳 → 阴）" : "（老阴 → 阳）";

                html += `<div style="margin:1em 0; padding-left:1em; border-left:4px solid #ffaa44;">
                <strong>${yaoName}${symbol}爻动</strong>　${changeText}<br>
                <span style="color:#e8d9c0;">${yaoCi}</span>
            </div>`;
            }
        });

        if (!hasAnyDong) {
            html += "<em>无动爻，以本卦卦辞为主。</em>";
        }
        html += `</div>`;

        html += `<div style="margin-top:1.5em; padding:1em; background:rgba(40,30,20,0.6); border-radius:12px; font-family: KaiTi, serif; line-height:1.8;">
			  <strong style="color:#ffcc66;">传统解卦口诀：</strong><br><br>
			  ${benGua.koujue ? benGua.koujue.replace(n/g, '<br>') : '暂无口诀'}
			</div>`;

        // 简单趋势提示（可选）
        // html += `<div style="margin-top:2em; font-style:italic; color:#aaa;">
        //     本卦「蒙」：启蒙、求师、蒙昧初开的状态。<br>
        //     之卦「震」：惊醒、行动、雷霆震动中求变。<br>
        //     多动爻（四动）：事态变动较大，宜静观其变、审慎决策。
        // </div>`;

        document.getElementById("result").innerHTML = html;
        document.getElementById("result").style.display = "block";
        document.getElementById("shakeBtn").disabled = true;
        document.getElementById("resetBtn").disabled = false;
    }


    // 重置函数
    function resetGame() {
        yaos = [];
        currentThrow = 0;
        isThrowing = false;
        document.getElementById("yaos").innerHTML = "";
        document.getElementById("result").style.display = "none";
        document.getElementById("status").textContent = "请摇卦（共需摇六次）";
        document.getElementById("shakeBtn").disabled = false;
        document.getElementById("resetBtn").disabled = true;

        // 重置铜钱外观
        [coin1, coin2, coin3].forEach(coin => {
            if (coin) coin.className = "coin front";
        });
    }

    // 事件绑定（必须在 DOM 加载后）
    document.addEventListener("DOMContentLoaded", function() {
        const shakeBtn = document.getElementById("shakeBtn");
        const resetBtn = document.getElementById("resetBtn");

        if (shakeBtn) shakeBtn.onclick = throwCoins;
        if (resetBtn) resetBtn.onclick = resetGame;

        // 空格键
        window.addEventListener("keydown", e => {
            if (e.code === "Space" && document.getElementById("shakeBtn") && !document.getElementById("shakeBtn").disabled) {
                e.preventDefault();
                throwCoins();
            }
        });

        console.log("页面 DOM 已加载，事件已绑定");
    });


</script>
</body>
</html>