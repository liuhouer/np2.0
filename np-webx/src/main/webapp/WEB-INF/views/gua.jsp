        },
        "001000": {
            id: 15,
            name: "谦",
            symbol: "䷎",
            upper: "艮", lower: "坤",
            guaci: "亨，君子有终。",
            yaoci: [
                "谦谦君子，用涉大川，吉。",
                "鸣谦，贞吉。",
